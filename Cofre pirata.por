programa {
  funcao inicio() {
    inteiro numeros[5], soma = 0 
    para (inteiro i = 0; i < 5; i++) {
    escreva ("Digite a senha do pirate vault: ")
  leia(numeros[i])
    }
    soma = numeros [0] + numeros [4]
    se (soma == numeros [2] ) {
      escreva("Senha válida, cofre aberto!!!")
    }
    senao {
      escreva ("Senha inválida, cofre bloqueado!!!")
    }
}
  }

